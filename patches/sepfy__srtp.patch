--- a/libsrtp/crypto/hash/hmac_mbedtls.c
+++ b/libsrtp/crypto/hash/hmac_mbedtls.c
@@ -0,0 +1,220 @@
+/*
+ * hmac_mbedtls.c
+ *
+ * HMAC-SHA1 backed by mbedTLS, so the ESP32 SHA peripheral does the work
+ * instead of the C implementation in sha1.c. Replaces hmac.c and sha1.c
+ * together: nothing else in the build calls srtp_sha1_*.
+ *
+ * The one structural difference from hmac.c is how a tag is restarted. That
+ * version keeps two srtp_sha1_ctx_t and memcpy()s the primed one over the
+ * working one for each packet. A hardware-backed context cannot be copied like
+ * that -- on ESP-IDF it holds peripheral state and is locked between the first
+ * update and the finish -- so this uses mbedtls_md_hmac_reset(), which is the
+ * same idea expressed through the API.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+/* err.h first: it defines srtp_debug_module_t, which cipher_types.h uses. */
+#include "err.h"
+
+#include "alloc.h"
+#include "auth.h"
+#include "cipher_types.h"
+
+#include "mbedtls/md.h"
+
+typedef struct {
+    mbedtls_md_context_t md;
+} srtp_hmac_mbedtls_ctx_t;
+
+srtp_debug_module_t srtp_mod_hmac = {
+    0,                  /* debugging is off by default */
+    "hmac sha-1 mbedtls" /* printable name for module   */
+};
+
+extern const srtp_auth_type_t srtp_hmac;
+
+static srtp_err_status_t srtp_hmac_mbedtls_alloc(srtp_auth_t **a,
+                                                 int key_len,
+                                                 int out_len)
+{
+    uint8_t *pointer;
+    srtp_hmac_mbedtls_ctx_t *state;
+    const mbedtls_md_info_t *info;
+
+    /* Same limits as the software version: SHA-1 block key, SHA-1 sized tag. */
+    if (key_len > 20) {
+        return srtp_err_status_bad_param;
+    }
+    if (out_len > 20) {
+        return srtp_err_status_bad_param;
+    }
+
+    pointer = (uint8_t *)srtp_crypto_alloc(sizeof(srtp_hmac_mbedtls_ctx_t) +
+                                           sizeof(srtp_auth_t));
+    if (pointer == NULL) {
+        return srtp_err_status_alloc_fail;
+    }
+
+    *a = (srtp_auth_t *)pointer;
+    (*a)->type = &srtp_hmac;
+    (*a)->state = pointer + sizeof(srtp_auth_t);
+    (*a)->out_len = out_len;
+    (*a)->key_len = key_len;
+    (*a)->prefix_len = 0;
+
+    state = (srtp_hmac_mbedtls_ctx_t *)(*a)->state;
+    mbedtls_md_init(&state->md);
+
+    info = mbedtls_md_info_from_type(MBEDTLS_MD_SHA1);
+    if (info == NULL) {
+        srtp_crypto_free(pointer);
+        *a = NULL;
+        return srtp_err_status_algo_fail;
+    }
+
+    /* 1 = allocate the HMAC ipad/opad buffers alongside the digest context */
+    if (mbedtls_md_setup(&state->md, info, 1) != 0) {
+        mbedtls_md_free(&state->md);
+        srtp_crypto_free(pointer);
+        *a = NULL;
+        return srtp_err_status_alloc_fail;
+    }
+
+    return srtp_err_status_ok;
+}
+
+static srtp_err_status_t srtp_hmac_mbedtls_dealloc(srtp_auth_t *a)
+{
+    srtp_hmac_mbedtls_ctx_t *state = (srtp_hmac_mbedtls_ctx_t *)a->state;
+
+    mbedtls_md_free(&state->md);
+
+    octet_string_set_to_zero(a, sizeof(srtp_hmac_mbedtls_ctx_t) +
+                                    sizeof(srtp_auth_t));
+    srtp_crypto_free(a);
+
+    return srtp_err_status_ok;
+}
+
+static srtp_err_status_t srtp_hmac_mbedtls_init(void *statev,
+                                                const uint8_t *key,
+                                                int key_len)
+{
+    srtp_hmac_mbedtls_ctx_t *state = (srtp_hmac_mbedtls_ctx_t *)statev;
+
+    if (key_len > 20) {
+        return srtp_err_status_bad_param;
+    }
+
+    if (mbedtls_md_hmac_starts(&state->md, key, (size_t)key_len) != 0) {
+        return srtp_err_status_auth_fail;
+    }
+
+    return srtp_err_status_ok;
+}
+
+static srtp_err_status_t srtp_hmac_mbedtls_start(void *statev)
+{
+    srtp_hmac_mbedtls_ctx_t *state = (srtp_hmac_mbedtls_ctx_t *)statev;
+
+    if (mbedtls_md_hmac_reset(&state->md) != 0) {
+        return srtp_err_status_auth_fail;
+    }
+
+    return srtp_err_status_ok;
+}
+
+static srtp_err_status_t srtp_hmac_mbedtls_update(void *statev,
+                                                  const uint8_t *message,
+                                                  int msg_octets)
+{
+    srtp_hmac_mbedtls_ctx_t *state = (srtp_hmac_mbedtls_ctx_t *)statev;
+
+    if (mbedtls_md_hmac_update(&state->md, message, (size_t)msg_octets) != 0) {
+        return srtp_err_status_auth_fail;
+    }
+
+    return srtp_err_status_ok;
+}
+
+static srtp_err_status_t srtp_hmac_mbedtls_compute(void *statev,
+                                                   const uint8_t *message,
+                                                   int msg_octets,
+                                                   int tag_len,
+                                                   uint8_t *result)
+{
+    srtp_hmac_mbedtls_ctx_t *state = (srtp_hmac_mbedtls_ctx_t *)statev;
+    uint8_t hash_value[20];
+    int i;
+
+    if (tag_len > 20) {
+        return srtp_err_status_bad_param;
+    }
+
+    if (mbedtls_md_hmac_update(&state->md, message, (size_t)msg_octets) != 0) {
+        return srtp_err_status_auth_fail;
+    }
+    if (mbedtls_md_hmac_finish(&state->md, hash_value) != 0) {
+        return srtp_err_status_auth_fail;
+    }
+
+    /* SRTP truncates the tag; callers ask for 4 or 10 of the 20 octets. */
+    for (i = 0; i < tag_len; i++) {
+        result[i] = hash_value[i];
+    }
+
+    /* Leave the context primed so the next start() is just a reset. */
+    if (mbedtls_md_hmac_reset(&state->md) != 0) {
+        return srtp_err_status_auth_fail;
+    }
+
+    return srtp_err_status_ok;
+}
