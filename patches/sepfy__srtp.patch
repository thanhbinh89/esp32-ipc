--- a/libsrtp/crypto/cipher/aes_icm_mbedtls.c
+++ b/libsrtp/crypto/cipher/aes_icm_mbedtls.c
@@ -0,0 +1,309 @@
+/*
+ * aes_icm_mbedtls.c
+ *
+ * AES integer counter mode backed by mbedTLS, so the ESP32 AES peripheral does
+ * the work instead of the table-driven C implementation in aes.c.
+ *
+ * This replaces aes_icm.c, not aes.c: ekt.c still calls srtp_aes_decrypt()
+ * directly, so the software primitive stays in the build for it.
+ *
+ * Why mbedTLS CTR rather than swapping the block primitive underneath
+ * aes_icm.c: on ESP-IDF every mbedtls_aes_* call takes the AES peripheral lock
+ * and enables the peripheral, so a per-16-byte-block call would pay that
+ * overhead ~82 times for a 1300 byte packet and end up slower than software.
+ * mbedtls_aes_crypt_ctr() runs the whole packet under one acquisition.
+ *
+ * Counter arithmetic: SRTP ICM defines a 16-bit block counter in the low two
+ * octets, while mbedtls_aes_crypt_ctr() increments the full 128-bit block as a
+ * big-endian integer. The two agree as long as the counter does not carry out
+ * of those two octets, i.e. for anything under 65536 blocks (1 MB) per IV.
+ * srtp_aes_icm_mbedtls_context_init() zeroes the low two octets, and an RTP
+ * packet is three orders of magnitude below that bound.
+ */
+
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+/* err.h first: it defines srtp_debug_module_t, which cipher_types.h uses. */
+#include "err.h"
+
+#include "aes.h"
+#include "alloc.h"
+#include "cipher.h"
+#include "cipher_types.h"
+
+#include "mbedtls/aes.h"
+
+typedef struct {
+    v128_t counter;         /* current counter block, consumed by mbedTLS  */
+    v128_t offset;          /* salt, XORed with the IV to make the counter */
+    mbedtls_aes_context aes;
+    uint8_t stream_block[16]; /* mbedTLS keystream remainder across calls  */
+    size_t nc_off;            /* offset into stream_block                  */
+    int key_size;             /* AES key size, without the 14 byte salt    */
+} srtp_aes_icm_mbedtls_ctx_t;
+
+srtp_debug_module_t srtp_mod_aes_icm = {
+    0,                 /* debugging is off by default */
+    "aes icm mbedtls" /* printable module name       */
+};
+
+extern const srtp_cipher_type_t srtp_aes_icm_128;
+extern const srtp_cipher_type_t srtp_aes_icm_256;
+
+static srtp_err_status_t srtp_aes_icm_mbedtls_alloc(srtp_cipher_t **c,
+                                                    int key_len,
+                                                    int tlen)
+{
+    srtp_aes_icm_mbedtls_ctx_t *icm;
+
+    (void)tlen;
+
+    if (key_len != SRTP_AES_ICM_128_KEY_LEN_WSALT &&
+        key_len != SRTP_AES_ICM_256_KEY_LEN_WSALT) {
+        return srtp_err_status_bad_param;
+    }
+
+    *c = (srtp_cipher_t *)srtp_crypto_alloc(sizeof(srtp_cipher_t));
+    if (*c == NULL) {
+        return srtp_err_status_alloc_fail;
+    }
+
+    icm = (srtp_aes_icm_mbedtls_ctx_t *)srtp_crypto_alloc(
+        sizeof(srtp_aes_icm_mbedtls_ctx_t));
+    if (icm == NULL) {
+        srtp_crypto_free(*c);
+        *c = NULL;
+        return srtp_err_status_alloc_fail;
+    }
+
+    mbedtls_aes_init(&icm->aes);
+
+    (*c)->state = icm;
+
+    switch (key_len) {
+    case SRTP_AES_ICM_256_KEY_LEN_WSALT:
+        (*c)->algorithm = SRTP_AES_ICM_256;
+        (*c)->type = &srtp_aes_icm_256;
+        icm->key_size = SRTP_AES_256_KEY_LEN;
+        break;
+    default:
+        (*c)->algorithm = SRTP_AES_ICM_128;
+        (*c)->type = &srtp_aes_icm_128;
+        icm->key_size = SRTP_AES_128_KEY_LEN;
+        break;
+    }
+
+    (*c)->key_len = key_len;
+
+    return srtp_err_status_ok;
+}
+
+static srtp_err_status_t srtp_aes_icm_mbedtls_dealloc(srtp_cipher_t *c)
+{
+    srtp_aes_icm_mbedtls_ctx_t *ctx;
+
+    if (c == NULL) {
+        return srtp_err_status_bad_param;
+    }
+
+    ctx = (srtp_aes_icm_mbedtls_ctx_t *)c->state;
+    if (ctx) {
+        mbedtls_aes_free(&ctx->aes);
+        octet_string_set_to_zero(ctx, sizeof(srtp_aes_icm_mbedtls_ctx_t));
+        srtp_crypto_free(ctx);
+    }
+
+    srtp_crypto_free(c);
+
+    return srtp_err_status_ok;
+}
+
+/*
+ * The key buffer holds key_size octets of key followed by SRTP_SALT_LEN octets
+ * of salt. The salt becomes the counter's fixed part; the low two octets are
+ * the block counter and must start at zero.
+ */
+static srtp_err_status_t srtp_aes_icm_mbedtls_context_init(void *cv,
+                                                           const uint8_t *key)
+{
+    srtp_aes_icm_mbedtls_ctx_t *c = (srtp_aes_icm_mbedtls_ctx_t *)cv;
+
+    v128_set_to_zero(&c->counter);
+    v128_set_to_zero(&c->offset);
+    memcpy(&c->counter, key + c->key_size, SRTP_SALT_LEN);
+    memcpy(&c->offset, key + c->key_size, SRTP_SALT_LEN);
+
+    c->offset.v8[SRTP_SALT_LEN] = c->offset.v8[SRTP_SALT_LEN + 1] = 0;
+    c->counter.v8[SRTP_SALT_LEN] = c->counter.v8[SRTP_SALT_LEN + 1] = 0;
+
+    c->nc_off = 0;
+    memset(c->stream_block, 0, sizeof(c->stream_block));
+
+    if (mbedtls_aes_setkey_enc(&c->aes, key, c->key_size * 8) != 0) {
+        return srtp_err_status_cipher_fail;
+    }
+
+    return srtp_err_status_ok;
+}
+
+static srtp_err_status_t srtp_aes_icm_mbedtls_set_iv(void *cv,
+                                                     uint8_t *iv,
+                                                     srtp_cipher_direction_t dir)
+{
+    srtp_aes_icm_mbedtls_ctx_t *c = (srtp_aes_icm_mbedtls_ctx_t *)cv;
+    v128_t nonce;
+
+    (void)dir; /* CTR keystream is the same in both directions */
+
+    v128_copy_octet_string(&nonce, iv);
+    v128_xor(&c->counter, &c->offset, &nonce);
+
+    /* Start a fresh keystream: nothing carries over between packets. */
+    c->nc_off = 0;
+    memset(c->stream_block, 0, sizeof(c->stream_block));
+
+    return srtp_err_status_ok;
+}
+
+static srtp_err_status_t srtp_aes_icm_mbedtls_encrypt(void *cv,
+                                                      unsigned char *buf,
+                                                      unsigned int *enc_len)
+{
+    srtp_aes_icm_mbedtls_ctx_t *c = (srtp_aes_icm_mbedtls_ctx_t *)cv;
+
+    if (mbedtls_aes_crypt_ctr(&c->aes, *enc_len, &c->nc_off, c->counter.v8,
+                              c->stream_block, buf, buf) != 0) {
+        return srtp_err_status_cipher_fail;
+    }
+
+    return srtp_err_status_ok;
+}
+
+static const char srtp_aes_icm_128_mbedtls_description[] =
+    "AES-128 counter mode using mbedtls";
+static const char srtp_aes_icm_256_mbedtls_description[] =
+    "AES-256 counter mode using mbedtls";
+
